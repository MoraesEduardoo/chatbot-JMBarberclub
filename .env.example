# ==============================================================================
# JM BARBERCLUB - VARIÁVEIS DE AMBIENTE (.env / .env.local)
# ==============================================================================
# Copie este arquivo para .env.local e preencha com as credenciais do seu projeto.
# Todas as chaves com NEXT_PUBLIC_ ficam expostas no navegador.
# As demais chaves são estritamente secretas e executadas no lado do servidor (Node.js).

# ------------------------------------------------------------------------------
# 1. SUPABASE (BANCO DE DADOS POSTGRESQL & AUTENTICAÇÃO)
# ------------------------------------------------------------------------------
# URL do Projeto Supabase (ex: https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave Anônima Pública (anon / public key) - utilizada pelo cliente no navegador e Server Actions
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Chave Administrativa Secreta (service_role key) - OBRIGATÓRIA para Server Actions,
# bypass seguro de RLS (Row Level Security) e tarefas administrativas de backend
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 2. DOMÍNIO E APLICAÇÃO (PWA / SEO / REDIRECIONAMENTO)
# ------------------------------------------------------------------------------
# URL pública oficial da aplicação web (ex: https://barberclub.jm.com.br ou https://meu-app.vercel.app)
NEXT_PUBLIC_SITE_URL=https://seu-dominio.com.br

# ------------------------------------------------------------------------------
# 3. NOTIFICAÇÕES & INTEGRAÇÃO COM PAINEL DO BARBEIRO
# ------------------------------------------------------------------------------
# Número oficial do WhatsApp da barbearia para suporte manual e links diretos (com DDI e DDD)
# Exemplo: 5511999999999 (Brasil: +55, DDD 11, número)
NEXT_PUBLIC_SHOP_WHATSAPP=5511999999999

# URL do Painel de Gestão dos Barbeiros (para disparar webhook ao criar agendamento)
ADMIN_PANEL_URL=https://admin.seu-dominio.com.br

# Segredo compartilhado para autenticação dos webhooks entre o Chatbot e o Painel
PUSH_WEBHOOK_SECRET=seu-segredo-de-webhook-super-seguro

# Chave pública VAPID para Web Push Notifications nativas no navegador dos clientes (opcional)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ------------------------------------------------------------------------------
# 4. CHATBOT / MENSAGERIA / WHATSAPP APIS (OPCIONAL - EVOLUTION / BAILEYS / Z-API)
# ------------------------------------------------------------------------------
# Configure caso conecte o chatbot a uma instância de WhatsApp API (ex: Evolution API)
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
WHATSAPP_INSTANCE_NAME=
